<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Customer Support</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;

      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .support-card {
      width: 100%;
      max-width: 600px;
      background: white;
      padding: 50px 30px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .support-icon {
      font-size: 50px;
      margin-bottom: 15px;
    }

    h1 {
      margin: 0 0 15px;
      font-size: 34px;
    }

    p {
      margin: 0 auto;
      max-width: 450px;
      line-height: 1.6;
      color: #667085;
      font-size: 16px;
    }

    .chat-button {
      display: inline-block;
      margin-top: 30px;
      padding: 14px 26px;
      background: #1677ff;
      color: white;
      border-radius: 10px;
      font-weight: bold;
    }

    .status {
      margin-top: 25px;
      font-size: 14px;
      color: #667085;
    }
  </style>
</head>

<body>

  <div class="support-card">

    <div class="support-icon">💬</div>

    <h1>Customer Support</h1>

    <p>
      Welcome to our customer support center.
      If you need assistance, our support team is here to help.
      Start a live chat with us using the chat button.
    </p>

    <div class="chat-button">
      Start Live Chat
    </div>

    <div class="status">
      Our support team is available to assist you.
    </div>

  </div>


  <!-- Smartsupp Live Chat -->

  <script type="text/javascript">

    var _smartsupp = _smartsupp || {};

    _smartsupp.key =
      '677fbf0d382de367282bf0977efd2797afaf0ec7';

    window.smartsupp || (function(d) {

      var s, c, o = smartsupp = function() {
        o._.push(arguments)
      };

      o._ = [];

      s = d.getElementsByTagName('script')[0];

      c = d.createElement('script');

      c.type = 'text/javascript';
      c.charset = 'utf-8';
      c.async = true;

      c.src = 'https://www.smartsuppchat.com/loader.js?';

      s.parentNode.insertBefore(c, s);

    })(document);

  </script>

  <noscript>
    Powered by
    <a href="https://www.smartsupp.com" target="_blank">
      Smartsupp
    </a>
  </noscript>

</body>
</html>